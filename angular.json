{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "fantasy-poc": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/fantasy-poc",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": [
              "@angular/material/prebuilt-themes/purple-green.css",
              "src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                },
                {
                  "replace": "src/app/app.routes.ts",
                  "with": "src/app/app.routes.customer.ts"
                }
              ]
            },
            "production-admin": {
              "baseHref": "/admin/",
              "budgets": [
                { "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.admin.ts"
                },
                {
                  "replace": "src/app/app.routes.ts",
                  "with": "src/app/app.routes.admin.ts"
                }
              ]
            },
            "admin-dev": {
              "baseHref": "/admin/",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.admin.local.ts"
                },
                {
                  "replace": "src/app/app.routes.ts",
                  "with": "src/app/app.routes.admin.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "fantasy-poc:build:production" },
            "production-admin": { "buildTarget": "fantasy-poc:build:production-admin" },
            "admin-dev": { "buildTarget": "fantasy-poc:build:admin-dev" },
            "development": { "buildTarget": "fantasy-poc:build:development" }
          },
          "defaultConfiguration": "development",
          "options": { "port": 4200 }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
